// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  TRIAL
  PREMIUM
}

enum MoodType {
  VERY_BAD
  BAD
  NEUTRAL
  GOOD
  VERY_GOOD
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  role         Role   @default(USER)

  plan        Plan      @default(TRIAL)
  trialEndsAt DateTime?
  isActive    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  consent        Consent?
  journalEntries JournalEntry[]
  moods          MoodEntry[]
  answers        QuestionAnswer[]
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Consent {
  id     String @id @default(uuid())
  userId String @unique

  termsAccepted     Boolean
  privacyAccepted   Boolean
  recordingAccepted Boolean @default(false)

  acceptedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JournalEntry {
  id       String  @id @default(uuid())
  userId   String
  content  String
  photoUrl String?
  audioUrl String?

  entryDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryDate])
}

model MoodEntry {
  id        String   @id @default(uuid())
  userId    String
  mood      MoodType
  reason    String?
  entryDate DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryDate])
}

model QuestionSet {
  id        String   @id @default(uuid())
  title     String
  startDate DateTime
  createdAt DateTime @default(now())

  questions Question[]
}

model Question {
  id            String @id @default(uuid())
  questionSetId String
  text          String
  order         Int

  questionSet QuestionSet      @relation(fields: [questionSetId], references: [id])
  answers     QuestionAnswer[]

  @@unique([questionSetId, order])
}

model QuestionAnswer {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  answer     String
  answerDate DateTime

  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([userId, answerDate]) // one answer per day
}

model AdminAudio {
  id        String   @id @default(uuid())
  title     String
  audioUrl  String
  createdAt DateTime @default(now())
}
